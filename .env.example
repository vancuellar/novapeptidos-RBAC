MONGO_URL=mongodb+srv://USER:PASSWORD@HOST/nova_peptides
DB_NAME=nova_peptides
JWT_SECRET=change-this-long-random-secret
CORS_ORIGINS=https://vancuellar.github.io
ADMIN_EMAIL=admin@exygenlabs.com
ADMIN_PASSWORD=change-this-admin-password

# ------------------------------------------------------------ El motor del chat
# Vale para LOS DOS chats: el del sitio (clientes) y el Asesor de Negocio del
# panel (admin y distribuidores). Ver modelo_ia.py.
#
# ⛔ TODO ESTO NACE APAGADO. Sin AI_PROVIDER el motor es Gemini y los dos chats se
# comportan exactamente como hoy.
#
# Cambiar de proveedor es cambiar UNA variable y reiniciar — no hay que tocar
# codigo. Las llaves tambien se pueden pegar desde Admin -> Cobros; el .env manda.
#
#   AI_PROVIDER=gemini | openai | kimi | claude
#   AI_PROVIDER_FALLBACK=gemini    <- a donde se cae si el de arriba FALLA
#                                     (429, red, 500). `ninguno` lo apaga.
#
# Un respaldo sin llave no entra en la cadena. Y ojo con la diferencia:
#   - el proveedor FALLA   -> contesta el respaldo, el cliente no se entera;
#   - falta la LLAVE       -> truena y lo dice. Es un error de despliegue y tiene
#                             que verse, no taparse con otro motor.
GEMINI_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
ANTHROPIC_API_KEY=

# El nombre del modelo, uno por motor. Si se deja vacio se usa el de omision.
# ⛔ Son variables SEPARADAS a proposito: con una sola, caer de GPT a Gemini le
# mandaria a Google el nombre de un modelo de OpenAI y el respaldo moriria con un
# 404 justo el dia que hace falta.
#
# OpenAI NO trae modelo por omision y se queda asi: sus nombres cambian seguido y
# el que sigue esta leido de su documentacion, NO probado contra la API (no hay
# llave todavia). Vacio y con un error que dice que falta es mas honesto que un
# 404 confuso en la primera consulta.
#
#   LO RECOMENDADO (analisis del 2026-08-01):
#     AI_MODEL_NAME_OPENAI=gpt-5.6-luna    <- $0.20 / $1.20 por millon de tokens
#   Si el español sale plano, se sube UNA linea y se reinicia:
#     AI_MODEL_NAME_OPENAI=gpt-5.6-terra   <- $2.00 / $12.00, 10x mas caro
AI_MODEL_NAME_GEMINI=
AI_MODEL_NAME_OPENAI=
AI_MODEL_NAME_KIMI=
AI_MODEL_NAME_CLAUDE=

# Solo para apuntar a otro endpoint (p.ej. el de China de Moonshot). Vacio = el global.
OPENAI_BASE_URL=
KIMI_BASE_URL=

# ------------------------------------------------------------ Envios (Skydropx PRO)
# Son DOS credenciales, no una: la API PRO usa OAuth2 (se cambian por un token de 2 h).
# La vieja SKYDROPX_API_KEY era de la API anterior y YA NO SIRVE.
# Tambien se pueden pegar desde Admin -> Cobros. El .env manda sobre el panel.
# Sin credenciales no se cotiza envio y el checkout sigue vendiendo igual.
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=
# Solo para apuntar a otro ambiente. Por omision: https://pro.skydropx.com/api/v1
SKYDROPX_API_URL=

# ⚠️ PENDIENTE DE CHRISTIAN: la direccion del REMITENTE.
# NO es la del dueño: va a ser la de un trabajador y todavia no la tenemos.
# ⛔ Sin estos datos el sistema se NIEGA a comprar guias (a proposito).
# La colonia (SKYDROPX_FROM_COLONIA) la exige la API PRO como area_level3.
SKYDROPX_FROM_NAME=
SKYDROPX_FROM_ADDRESS1=
SKYDROPX_FROM_ADDRESS2=
SKYDROPX_FROM_COLONIA=
SKYDROPX_FROM_CITY=
SKYDROPX_FROM_PROVINCE=
SKYDROPX_FROM_ZIP=
SKYDROPX_FROM_PHONE=
SKYDROPX_FROM_EMAIL=
SKYDROPX_FROM_REFERENCE=
SKYDROPX_FROM_COMPANY=Exygen Labs

# ------------------------------------------- Acuerdo de Distribuidor (aceptacion)
# EL INTERRUPTOR. Enciende la aceptacion electronica del Acuerdo de Distribuidor
# (casilla NO premarcada + registro de version, fecha, IP y user-agent, y copia
# descargable). Ver acuerdo.py.
#
# ⛔ NACE APAGADO Y ASI SE QUEDA HASTA QUE CHRISTIAN LO DIGA. El texto v2 todavia
# trae [CORCHETES] sin resolver: razon social, RFC, domicilio, plazos y fuero.
# Encenderlo antes seria recabar firmas sobre un contrato incompleto.
#
# Apagado (o ausente): NADA cambia para ningun distribuidor.
# Encendido: al activar una cuenta de distribuidor y a los que ya existen en su
# siguiente entrada al panel se les pide firmar; sin firmar no se generan codigos
# nuevos, no se puede cotizar y no se devengan comisiones nuevas. Ver su panel,
# sus ventas y lo que ya ganaron sigue abierto.
#
# Para encender:  ACUERDO_DISTRIBUIDOR_ACTIVO=true   y ./deploy.sh
# Para apagar:    quitar la linea (o poner false)    y ./deploy.sh
# Apagar NO borra las aceptaciones ya recabadas: siguen en `acuerdos_aceptados`.
ACUERDO_DISTRIBUIDOR_ACTIVO=false
